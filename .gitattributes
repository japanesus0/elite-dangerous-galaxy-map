# Normalize text files to LF in the repo, leave the working copy alone.
* text=auto eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.docx binary
*.pdf  binary

# Vendored third-party JS — don't include in language stats / diffs
ed-map/static/vendor/** linguist-vendored
