# Copy this file to `.env` and adjust values for local use.
# `.env` is git-ignored so real credentials never enter version control.

# PostgreSQL (used by the postgres container and all clients)
POSTGRES_USER=elite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=elite_dangerous

# Optional overrides (defaults shown):
# POSTGRES_HOST=postgres        # service name inside docker-compose network
# POSTGRES_PORT=5432
# ED_LOGS_DIR=/data/logs        # where the watcher / etl look for Journal*.log
# POLL_INTERVAL=30              # watcher poll cadence (seconds)
# MAP_HOST=0.0.0.0
# MAP_PORT=8051
